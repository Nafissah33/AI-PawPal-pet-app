classDiagram
    class Owner {
        +string name
        +dict preferences
        +update_preferences(prefs) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +string name
        +string species
        +string breed
        +add_task(task) void
        +remove_task(task) void
        +get_tasks() list~Task~
    }

    class Task {
        +string title
        +int duration_minutes
        +string priority
        +string category
        +string recurrence
        +bool completed
        +string id
        +edit(fields) void
        +mark_complete() void
        +mark_incomplete() void
    }

    class Scheduler {
        +int available_minutes
        +generate_plan(tasks) list
        +generate_plan_for_owner(owner) list
        +sort_tasks(tasks) list~Task~
        +filter_tasks(tasks) list~Task~
        +explain_plan(plan) string
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler ..> Task : schedules
    Scheduler ..> Owner : retrieves tasks from
