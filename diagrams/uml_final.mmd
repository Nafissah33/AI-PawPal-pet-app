classDiagram
    class Owner {
        +string name
        +dict preferences
        +List~Pet~ pets
        +update_preferences(prefs) void
        +add_pet(pet) void
        +get_all_tasks() list~Task~
        +to_dict() dict
        +from_dict(data) Owner
        +save_to_json(filepath) void
        +load_from_json(filepath) Owner
    }

    class Pet {
        +string name
        +string species
        +string breed
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +get_tasks() list~Task~
        +complete_task(task, completed_on) Task
        +to_dict() dict
        +from_dict(data) Pet
    }

    class Task {
        +string title
        +int duration_minutes
        +string priority
        +string category
        +string recurrence
        +string preferred_time
        +string due_date
        +bool completed
        +string id
        +edit(fields) void
        +mark_complete() void
        +mark_incomplete() void
        +to_dict() dict
        +from_dict(data) Task
    }

    class Scheduler {
        +int available_minutes
        +sort_tasks(tasks) list~Task~
        +filter_tasks(tasks, today) list~Task~
        +detect_conflicts(tasks) list
        +find_next_available_slot(plan, duration_minutes) string
        +generate_plan(tasks, start_time, today) list
        +generate_plan_for_owner(owner, start_time, today) list
        +explain_plan(plan) string
    }

    Owner "1" *-- "*" Pet : owns
    Pet "1" *-- "*" Task : has
    Pet ..> Task : creates next occurrence (complete_task)
    Scheduler ..> Task : sorts, filters, schedules
    Scheduler ..> Owner : retrieves tasks from (generate_plan_for_owner)
